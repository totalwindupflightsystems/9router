diff --git a/monitoring/fleet-monitoring/stack/loki/loki-config.active.yml b/monitoring/fleet-monitoring/stack/loki/loki-config.active.yml
new file mode 100644
index 000000000..294538506
--- /dev/null
+++ b/monitoring/fleet-monitoring/stack/loki/loki-config.active.yml
@@ -0,0 +1,78 @@
+# fleet-monitoring — Loki (single binary, FILESYSTEM chunk storage)
+#
+# The secretless first-boot variant: no object storage, no credentials. Selected by
+# render-configs.sh when LOKI_STORAGE=local, or LOKI_STORAGE=auto with no S3 credentials.
+# Chunks live on the loki-data volume, so logs do NOT survive a host rebuild — that is the
+# trade a machine with no S3 credentials makes to boot at all. Production runs loki-config.yml
+# (S3) and keeps the short local retention.
+
+auth_enabled: false
+
+server:
+  http_listen_port: 3100
+  grpc_listen_port: 9095
+  log_level: warn
+
+common:
+  path_prefix: /loki
+  replication_factor: 1
+  ring:
+    kvstore:
+      store: inmemory
+  storage:
+    filesystem:
+      chunks_directory: /loki/chunks
+      rules_directory: /loki/rules
+
+schema_config:
+  configs:
+    - from: 2026-01-01
+      store: tsdb
+      object_store: filesystem
+      schema: v13
+      index:
+        prefix: index
+        period: 24h
+
+storage_config:
+  tsdb_shipper:
+    active_index_directory: /loki/tsdb-index
+    cache_location: /loki/tsdb-cache
+    cache_ttl: 24h
+  filesystem:
+    directory: /loki/chunks
+
+limits_config:
+  retention_period: ${LOKI_RETENTION:-720h}
+  reject_old_samples: true
+  reject_old_samples_max_age: 168h
+  allow_structured_metadata: true
+  volume_enabled: true
+  # this fleet is a few dozen hosts — generous per-tenant limits, no multi-tenancy
+  ingestion_rate_mb: 16
+  ingestion_burst_size_mb: 32
+  max_streams_per_user: 20000
+  max_query_series: 5000
+
+compactor:
+  working_directory: /loki/compactor
+  delete_request_store: filesystem
+  retention_enabled: true
+  compaction_interval: 10m
+  retention_delete_delay: 2h
+  retention_delete_worker_count: 150
+
+ruler:
+  storage:
+    type: local
+    local:
+      directory: /loki/rules
+  rule_path: /loki/rules-temp
+  alertmanager_url: http://alertmanager:9093
+  ring:
+    kvstore:
+      store: inmemory
+  enable_api: true
+
+analytics:
+  reporting_enabled: false
