{
  "title": "Services (postgres / redis / traefik)",
  "uid": "fleet-services",
  "tags": ["fleet", "fleet-monitoring", "services"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Postgres up (master001)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "max(pg_up{job=\"services-postgres\"})", "legendFormat": "pg_up" }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null },
        { "color": "green", "value": 1 }
      ] } }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Redis up (master001)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "max(redis_up{job=\"services-redis\"})", "legendFormat": "redis_up" }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null },
        { "color": "green", "value": 1 }
      ] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Traefik metrics",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "description": "SKIPPED: enabling traefik /metrics requires editing Coolify proxy static args + a proxy restart (fleet traffic risk). Panel shows 0 until it is enabled.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "count(treo_request_duration_seconds_bucket) OR vector(0)", "legendFormat": "series" }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "orange", "value": null }
      ] } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Postgres connections (coolify db)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "max(pg_stat_database_numbackends{job=\"services-postgres\",datname=\"coolify\"})", "legendFormat": "backends" }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "blue", "value": null }
      ] } }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "Postgres connections by database",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (datname) (pg_stat_database_numbackends{job=\"services-postgres\"})", "legendFormat": "{{datname}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Redis memory used",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "redis_memory_used_bytes{job=\"services-redis\"}", "legendFormat": "used" },
        { "refId": "B", "expr": "redis_memory_max_bytes{job=\"services-redis\"}", "legendFormat": "max" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Redis ops/sec by command",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "topk(6, sum by (cmd) (rate(redis_commands_total{job=\"services-redis\"}[5m])))", "legendFormat": "{{cmd}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Postgres transaction rate",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{job=\"services-postgres\"}[5m]))", "legendFormat": "commit {{datname}}" },
        { "refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{job=\"services-postgres\"}[5m]))", "legendFormat": "rollback {{datname}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Traefik request rate (SKIPPED source — placeholder until metrics are enabled)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "description": "Traefik Prometheus metrics disabled (needs proxy restart on master001). No query wired; panel intentionally empty.",
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [
        { "refId": "A", "expr": "vector(0)", "legendFormat": "traefik (not enabled)" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    }
  ]
}