# fleet-monitoring — copy to .env and fill in. NEVER commit the filled file.
#
# A zero-edit copy is enough to BOOT a clean machine with no real secrets: the values marked
# "dev default" below are non-secret dummies and check-env accepts them with a warning.
# Replace them (openssl rand -base64 24) before this stack serves anything real.

# ---------- identity ----------
# Used in dashboards, alert annotations and the Tailscale device name.
MONITORING_HOSTNAME=backoffice-mon
TAILNET=tail448ac.ts.net

# ---------- Grafana ----------
GRAFANA_USER=admin
# dev default — non-secret dummy so `cp .env.example .env` boots. REPLACE for real use.
GRAFANA_PASSWORD=dev-only-admin
# No public port: reach Grafana over the tailnet or an SSH tunnel.
GRAFANA_BIND=127.0.0.1

# ---------- retention / cost knobs ----------
# Prometheus local TSDB retention (S3 snapshots extend it, they don't replace it)
PROM_RETENTION=30d
PROM_RETENTION_SIZE=8GB
# Loki is the volume driver. With LOKI_STORAGE=s3 chunks go to S3 and local retention is
# short; with local storage the loki-data volume is the whole store.
LOKI_RETENTION=720h

# ---------- S3 (Hetzner Object Storage, hel1) ----------
# Where Loki keeps its chunks. LOKI_STORAGE selects the backend:
#   auto  (default) = s3 when BOTH S3_ACCESS_KEY and S3_SECRET_KEY are non-empty, else local
#   s3              = always S3; check-env then REQUIRES the credentials below
#   local           = always the local filesystem; no S3 credentials needed to boot
# local is what makes a fresh machine bootable with no secrets — chunks then live on the
# loki-data volume only and do NOT survive a host rebuild, which is why production runs s3.
LOKI_STORAGE=auto
S3_BUCKET=karahermes-hel
S3_PREFIX=monitoring
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
# Hetzner Object Storage S3 credentials (NOT the Cloud API token).
# Required only when LOKI_STORAGE=s3, or auto with both set.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Hetzner Cloud (terraform) ----------
HCLOUD_TOKEN=
# Project the monitoring host belongs to
HCLOUD_PROJECT=backoffice
# Existing server to attach the firewall to (empty => create one, capacity permitting)
MONITORING_SERVER_ID=
# Tailscale IPv4 of the monitoring host — the only address allowed to reach exporters
MONITORING_TAILNET_CIDR=100.64.0.0/10

# ---------- Tailscale ----------
# Reusable auth key (ephemeral=false, preauthorized). Rendered into cloud-init.
TAILSCALE_AUTHKEY=
TAILSCALE_TAGS=tag:monitoring

# ---------- alert -> agent bridge ----------
ALERT_ROUTER_PORT=8089
# Shared secret Alertmanager must present; the router rejects anything else.
# dev default — non-secret dummy so `cp .env.example .env` boots. REPLACE for real use.
ALERT_ROUTER_TOKEN=dev-only-router-token
# Where the board lives on this host (lane boards are read for row ids)
BOARD_ROOT=/home/kara
# Set to 1 to actually append board rows; 0 = dry-run (log the row it WOULD write)
ALERT_ROUTER_WRITE=0
# Optional: message the lane when a critical alert fires
ALERT_ROUTER_NOTIFY=0

# Set true only while capturing dashboard screenshots; keep false in normal operation.
GRAFANA_ANONYMOUS=false
# Shared secret between grafana and the image renderer (required; generate with openssl rand -hex 32)
# dev default — non-secret dummy so `cp .env.example .env` boots. REPLACE for real use.
RENDERER_TOKEN=dev-only-renderer-token
