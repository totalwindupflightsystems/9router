{
  "id": null,
  "uid": "fleet-cost-tokens",
  "title": "Fleet Cost & Tokens",
  "tags": [
    "fleet",
    "cost",
    "tokens"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "day",
        "label": "UTC day",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": {
          "query": "label_values(hermes_session_est_cost_usd, day)",
          "refId": "day"
        },
        "definition": "label_values(hermes_session_est_cost_usd, day)",
        "refresh": 2,
        "sort": 2,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tokens IN per UTC day by lane",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (day, lane) (hermes_session_tokens_in)",
          "legendFormat": "{{lane}} {{day}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Estimated spend per UTC day by provider (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (day, provider) (hermes_session_est_cost_usd)",
          "legendFormat": "{{provider}} {{day}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Top 10 spenders by lane \u2014 selected day",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "barRadius": 0
      },
      "targets": [
        {
          "expr": "topk(10, sum by (lane) (hermes_session_est_cost_usd{day=\"$day\"}))",
          "legendFormat": "{{lane}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Real estimated $ / lane / selected day",
      "description": "Daily totals are attributed to the UTC date of sessions.started_at. Source values are session_model_usage.estimated_cost_usd.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (lane, provider) (hermes_session_est_cost_usd{day=\"$day\"})",
          "legendFormat": "{{lane}} \u2014 {{provider}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost per API call (work unit), selected day",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (lane) (hermes_session_est_cost_usd{day=\"$day\"}) / clamp_min(sum by (lane) (hermes_session_api_calls{day=\"$day\"}), 1)",
          "legendFormat": "{{lane}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache-hit ratio by lane, selected day",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (lane) (hermes_session_cache_read_tokens{day=\"$day\"}) / clamp_min(sum by (lane) (hermes_session_cache_read_tokens{day=\"$day\"}) + sum by (lane) (hermes_session_tokens_in{day=\"$day\"}), 1)",
          "legendFormat": "{{lane}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tokens OUT per UTC day by lane",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (day, lane) (hermes_session_tokens_out)",
          "legendFormat": "{{lane}} {{day}}",
          "refId": "A"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [],
  "description": "Fleet cost & token usage from hermes_session_* (hermes-cost-exporter on the work box, MON-DOGFOOD-039). Daily gauges keyed by (day, lane, provider)."
}
